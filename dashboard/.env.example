NODE_ENV=development

POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=mydatabase

PGADMIN_EMAIL=admin@mail.com
PGADMIN_PASSWORD=admin

DATABASE_URL=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5432/POSTGRES_DB

SECRET_KEY=your_secret_key_here
PASSWORD_HASH_SALT=your_salt_value_here
JWT_ALGORITHM=HS256

ACCESS_TOKEN_LIFETIME=2h
REFRESH_TOKEN_LIFETIME=1d

REQUEST_TIMEOUT_MS=2000

# NextAuth.js v4 (mirrored to NEXTAUTH_SECRET / NEXTAUTH_URL at runtime in env.ts)
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=your_auth_secret_here
# Public origin used to build OAuth callback URLs.
# Local dev: set this to http://localhost:3000
# Vercel Production: set in the Production env scope (e.g. https://app.example.com)
# Vercel Preview: leave UNSET — env.ts will auto-derive from VERCEL_URL
AUTH_URL=http://localhost:3000

# Google OAuth provider (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI in Google must be: <AUTH_URL>/api/auth/callback/google
# For Preview deploys, either (a) point Google at a stable preview alias domain
# you control, or (b) use a single production callback and proxy back to the
# preview URL after sign-in. Google does NOT accept wildcard redirect URIs.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# Optional / documentation only — NextAuth derives the real callback from AUTH_URL.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google